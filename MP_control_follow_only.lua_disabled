-- Follow-only control for kangaroo target in Plane GUIDED mode.
-- Reads SCR_USER1..6 bus values and sets GUIDED target directly (no weave path).

local MODE_GUIDED = 15
local ALT_FRAME_ABSOLUTE = 0
local MAV_SEVERITY = {
    EMERGENCY = 0, ALERT = 1, CRITICAL = 2, ERROR = 3,
    WARNING = 4, NOTICE = 5, INFO = 6, DEBUG = 7
}

local BUS_STALE_SEC        = 1.0
local REPORT_INTERVAL_MS   = 2000
local PLANE_ABOVE_TARGET_M = 150.0
local KANG_ALT_M_FALLBACK  = 80.0

-- -----------------------------------------------------------------------
-- ADSB rx (currently unused - send_chan loopback doesn't reach receive_chan
-- in a standard SITL/MAVProxy setup; bus params are used instead)
-- -----------------------------------------------------------------------
-- local ADSB_VEHICLE_MSGID = 246
-- local ADSB_PAYLOAD_LEN   = 38  -- 4xI4 + 5xI2 + B + c9 + 2xB
-- mavlink:init(10, 1)
-- mavlink:register_rx_msgid(ADSB_VEHICLE_MSGID)
--
-- local function read_adsb_target()
--     local latest = nil
--     while true do
--         local msg, _ = mavlink:receive_chan()
--         if msg == nil then break end
--         local msgid = string.unpack("<I3", msg, 10)
--         if msgid == ADSB_VEHICLE_MSGID then
--             local payload_len = string.unpack("<B", msg, 4)
--             local payload = string.sub(msg, 13, 12 + payload_len)
--             if #payload < ADSB_PAYLOAD_LEN then
--                 payload = payload .. string.rep("\0", ADSB_PAYLOAD_LEN - #payload)
--             end
--             local _, lat_e7, lon_e7, alt_mm = string.unpack("<I4i4i4i4", payload, 1)
--             local loc = Location()
--             loc:lat(lat_e7)
--             loc:lng(lon_e7)
--             loc:set_alt_m(alt_mm * 0.001, ALT_FRAME_ABSOLUTE)
--             latest = { loc = loc, alt_m = alt_mm * 0.001 }
--         end
--     end
--     return latest
-- end
-- -----------------------------------------------------------------------

local bus_seq_param = Parameter()
local bus_seq_ready = bus_seq_param:init("SCR_USER1")
assert(bus_seq_ready, "missing SCR_USER1")

local bus_t_s_param = Parameter()
local bus_t_s_ready = bus_t_s_param:init("SCR_USER2")
assert(bus_t_s_ready, "missing SCR_USER2")

local bus_lat_param = Parameter()
local bus_lat_ready = bus_lat_param:init("SCR_USER3")
assert(bus_lat_ready, "missing SCR_USER3")

local bus_lon_param = Parameter()
local bus_lon_ready = bus_lon_param:init("SCR_USER4")
assert(bus_lon_ready, "missing SCR_USER4")

local bus_vn_param = Parameter()
local bus_vn_ready = bus_vn_param:init("SCR_USER5")
assert(bus_vn_ready, "missing SCR_USER5")

local bus_ve_param = Parameter()
local bus_ve_ready = bus_ve_param:init("SCR_USER6")
assert(bus_ve_ready, "missing SCR_USER6")

local kang_alt_m_param = Parameter()
local kang_alt_m_ready = kang_alt_m_param:init("KANG_ALT_M")

local math_helpers = require("math_helpers")

local last_bus_seq_seen  = 0
local last_report_ms     = 0
local last_warn_stale_ms = 0

local function all_bus_ready()
    return bus_seq_ready and bus_t_s_ready and bus_lat_ready and bus_lon_ready and bus_vn_ready and bus_ve_ready
end

local function get_kangaroo_alt_m()
    if not kang_alt_m_ready then
        kang_alt_m_ready = kang_alt_m_param:init("KANG_ALT_M")
    end
    if kang_alt_m_ready then
        local alt_m = kang_alt_m_param:get()
        if alt_m ~= nil then
            return alt_m
        end
    end
    return KANG_ALT_M_FALLBACK
end

local function get_home_alt_m()
    if ahrs:home_is_set() then
        local home = ahrs:get_home()
        if home ~= nil and home:alt() ~= nil then
            return home:alt() * 0.01
        end
    end

    local pos = ahrs:get_position()
    if pos ~= nil then
        pos:change_alt_frame(ALT_FRAME_ABSOLUTE)
        local pos_alt_cm = pos:alt()
        if pos_alt_cm ~= nil then
            return pos_alt_cm * 0.01
        end
    end

    return nil
end

local function read_bus_target()
    if not all_bus_ready() then
        return nil
    end

    local seq_1 = bus_seq_param:get()
    if seq_1 == nil or (seq_1 % 2) ~= 0 then
        return nil
    end

    local t_s = bus_t_s_param:get()
    local lat_deg = bus_lat_param:get()
    local lon_deg = bus_lon_param:get()
    local vn = bus_vn_param:get()
    local ve = bus_ve_param:get()
    if t_s == nil or lat_deg == nil or lon_deg == nil or vn == nil or ve == nil then
        return nil
    end

    local seq_2 = bus_seq_param:get()
    if seq_2 == nil or seq_1 ~= seq_2 or (seq_2 % 2) ~= 0 then
        return nil
    end

    if seq_2 == last_bus_seq_seen then
        return nil
    end

    local now_s = millis():toint() * 0.001
    if (now_s - t_s) > BUS_STALE_SEC then
        return { stale = true }
    end

    local loc = Location()
    loc:lat(math_helpers.deg_to_e7(lat_deg))
    loc:lng(math_helpers.deg_to_e7(lon_deg))

    last_bus_seq_seen = seq_2

    return {
        stale        = false,
        loc          = loc,
        vn           = vn,
        ve           = ve,
        seq          = seq_2,
        timestamp_ms = math.floor(t_s * 1000.0 + 0.5)
    }
end

local function set_follow_target(kangaroo)
    if kangaroo == nil or kangaroo.loc == nil then
        return false
    end

    local home_alt_m = get_home_alt_m()
    if home_alt_m == nil then
        return false
    end

    local target_loc = kangaroo.loc:copy()
    target_loc:change_alt_frame(ALT_FRAME_ABSOLUTE)
    local target_alt_m = home_alt_m + get_kangaroo_alt_m() + PLANE_ABOVE_TARGET_M
    target_loc:set_alt_m(target_alt_m, ALT_FRAME_ABSOLUTE)

    return vehicle:set_target_location(target_loc)
end

local function update()
    if vehicle:get_mode() ~= MODE_GUIDED then
        return update, 100
    end

    local kangaroo_latest = read_bus_target()
    if kangaroo_latest == nil then
        return update, 100
    end

    local now_ms = millis():toint()
    if kangaroo_latest.stale then
        if now_ms - last_warn_stale_ms >= REPORT_INTERVAL_MS then
            last_warn_stale_ms = now_ms
            gcs:send_text(MAV_SEVERITY.WARNING, "CTRL_FOLLOW: stale kangaroo bus sample")
        end
        return update, 100
    end

    if not set_follow_target(kangaroo_latest) then
        if now_ms - last_warn_stale_ms >= REPORT_INTERVAL_MS then
            last_warn_stale_ms = now_ms
            gcs:send_text(MAV_SEVERITY.WARNING, "CTRL_FOLLOW: failed to set guided target")
        end
        return update, 100
    end

    if now_ms - last_report_ms >= REPORT_INTERVAL_MS then
        last_report_ms = now_ms
        gcs:send_text(
            MAV_SEVERITY.INFO,
            string.format(
                "CTRL_FOLLOW: seq=%u lat=%.7f lon=%.7f",
                kangaroo_latest.seq,
                kangaroo_latest.loc:lat() * 1.0e-7,
                kangaroo_latest.loc:lng() * 1.0e-7
            )
        )
    end

    return update, 100
end

gcs:send_text(MAV_SEVERITY.INFO, "CTRL_FOLLOW: loaded (GUIDED follow only)")

local function protected_wrapper()
    local ok, err = pcall(update)
    if not ok then
        gcs:send_text(MAV_SEVERITY.ERROR, "CTRL_FOLLOW: " .. tostring(err))
        return protected_wrapper, 1000
    end
    return protected_wrapper, 100
end

return protected_wrapper()
