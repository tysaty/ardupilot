.DS_Store
__pycache__/
*.py[cod]

# SITL campaign staging output (kangaroo_follow/stage_scripts.py): copied or
# generated fresh for every cell and deleted by restore(). The runner's source
# is Tools/autotest/ArduPlane_Tests/KangarooFollow/sitl_harness_runner.lua;
# each sitl_cell.lua is generated from a cell's spec.json.
/sitl_harness_runner.lua
/modules/sitl_cell.lua

# SITL demo staging output (kangaroo_follow/demo.py --stage): copied or
# generated by staging and deleted by --restore. Never commit them; the
# sources are under Tools/autotest/ArduPlane_Tests/KangarooFollow/ and the
# flight package (kangaroo_follow/flight_package/) holds the specs that fly.
/spec.json
/kangaroo_demo.lua
/modules/sitl_spec.lua
/.sitl-staged.json
*.sitl-off
