-- =========================================================
-- Control loop with explicit state machine
-- Refactored from uploaded file
-- Source reviewed: fileciteturn0file0
-- =========================================================

-- -----------------------------
-- Vehicle / altitude constants
-- -----------------------------
local MODE_AUTO = 10
local MODE_GUIDED = 15
local ALT_FRAME_ABSOLUTE = 0

local PLANE_ABOVE_TARGET_M = 150.0
local KANG_ALT_M_FALLBACK = 80.0

-- -----------------------------
-- Waypoint acceptance tuning
-- -----------------------------
local WP_ACCEPT_RADIUS_M = 40.0
local MIN_WP_ACCEPT_RADIUS_M = 20.0
local REACHED_STREAK_REQUIRED = 1

-- -----------------------------
-- Reporting / timing
-- -----------------------------
local REPORT_INTERVAL_MS = 2000
local last_report_ms = 0
local UPDATE_PERIOD_MS = 200

local MIN_DUBINS_POINTS = 5

-- -----------------------------
-- State machine
-- -----------------------------
local STATES = {
    IDLE = 0,
    BUILD_PATH = 1,
    EXECUTE_PATH = 2,
    HOLD = 3
}

local state = STATES.IDLE

-- -----------------------------
-- Controller state
-- -----------------------------
local controller_busy = false
local dubins_point_index = nil
local dubins_point_count = nil
local dubins_points_active = nil

local kangaroo_loc_pending = nil
local kangaroo_loc_active = nil

local reached_streak = 0
local reached_index = -1

-- -----------------------------
-- Parameters
-- -----------------------------
local bus_seq_param = Parameter()
local bus_seq_ready = bus_seq_param:init("SCR_USER1")
assert(bus_seq_ready, "missing SCR_USER1")

local bus_t_s_param = Parameter()
local bus_t_s_ready = bus_t_s_param:init("SCR_USER2")
assert(bus_t_s_ready, "missing SCR_USER2")

local bus_lat_param = Parameter()
local bus_lat_ready = bus_lat_param:init("SCR_USER3")
assert(bus_lat_ready, "missing SCR_USER3")

local bus_lon_param = Parameter()
local bus_lon_ready = bus_lon_param:init("SCR_USER4")
assert(bus_lon_ready, "missing SCR_USER4")

local bus_vn_param = Parameter()
local bus_vn_ready = bus_vn_param:init("SCR_USER5")
assert(bus_vn_ready, "missing SCR_USER5")

local bus_ve_param = Parameter()
local bus_ve_ready = bus_ve_param:init("SCR_USER6")
assert(bus_ve_ready, "missing SCR_USER6")

local kang_alt_m_param = Parameter()
local kang_alt_m_ready = kang_alt_m_param:init("KANG_ALT_M")

local last_bus_seq_seen = 0

-- -----------------------------
-- Modules
-- -----------------------------
local dubins_points = require("dubins_weave_full")
local math_helpers = require("math_helpers")

gcs:send_text(4, "Control: loaded at boot")

-- =========================================================
-- Utility helpers
-- =========================================================

local function state_name(s)
    if s == STATES.IDLE then
        return "IDLE"
    elseif s == STATES.BUILD_PATH then
        return "BUILD_PATH"
    elseif s == STATES.EXECUTE_PATH then
        return "EXECUTE_PATH"
    elseif s == STATES.HOLD then
        return "HOLD"
    end
    return "UNKNOWN"
end

local function set_state(new_state)
    if state ~= new_state then
        gcs:send_text(4, string.format("Control: %s -> %s", state_name(state), state_name(new_state)))
        state = new_state
    end
end

local function reset_reached_flags()
    reached_streak = 0
    reached_index = -1
end

local function reset_execution_state()
    controller_busy = false
    dubins_points_active = nil
    dubins_point_index = nil
    dubins_point_count = nil
    kangaroo_loc_active = nil
    reset_reached_flags()
end

local function current_point()
    if dubins_points_active == nil or dubins_point_index == nil then
        return nil
    end
    return dubins_points_active[dubins_point_index]
end

local function next_point()
    if dubins_points_active == nil or dubins_point_index == nil then
        return nil
    end
    return dubins_points_active[dubins_point_index + 1]
end

local function path_finished()
    return dubins_point_count ~= nil
       and dubins_point_index ~= nil
       and dubins_point_index > dubins_point_count
end

local function all_bus_ready()
    return bus_seq_ready and bus_t_s_ready and bus_lat_ready and bus_lon_ready and bus_vn_ready and bus_ve_ready
end

local function get_kangaroo_alt_m()
    if not kang_alt_m_ready then
        kang_alt_m_ready = kang_alt_m_param:init("KANG_ALT_M")
    end
    if kang_alt_m_ready then
        local alt_m = kang_alt_m_param:get()
        if alt_m ~= nil then
            return alt_m
        end
    end
    return KANG_ALT_M_FALLBACK
end

local function get_home_alt_m()
    if ahrs:home_is_set() then
        local home = ahrs:get_home()
        if home ~= nil and home:alt() ~= nil then
            return home:alt() * 0.01
        end
    end

    local pos = ahrs:get_position()
    if pos ~= nil then
        pos:change_alt_frame(ALT_FRAME_ABSOLUTE)
        local pos_alt_cm = pos:alt()
        if pos_alt_cm ~= nil then
            return pos_alt_cm * 0.01
        end
    end

    return nil
end

-- =========================================================
-- Target / bus handling
-- =========================================================

local function read_bus_target()
    if not all_bus_ready() then
        return nil
    end

    local seq_1 = bus_seq_param:get()
    if seq_1 == nil then
        return nil
    end

    if (seq_1 % 2) ~= 0 then
        return nil
    end

    local t_s = bus_t_s_param:get()
    local lat_deg = bus_lat_param:get()
    local lon_deg = bus_lon_param:get()
    local vn = bus_vn_param:get()
    local ve = bus_ve_param:get()

    if t_s == nil or lat_deg == nil or lon_deg == nil or vn == nil or ve == nil then
        return nil
    end

    local seq_2 = bus_seq_param:get()
    if seq_2 == nil then
        return nil
    end

    if seq_1 ~= seq_2 or (seq_2 % 2) ~= 0 then
        return nil
    end

    if seq_2 == last_bus_seq_seen then
        return nil
    end

    local now_s = millis():toint() * 0.001
    if (now_s - t_s) > 1.0 then
        return nil
    end

    local loc = Location()
    loc:lat(math_helpers.deg_to_e7(lat_deg))
    loc:lng(math_helpers.deg_to_e7(lon_deg))

    last_bus_seq_seen = seq_2

    return {
        loc = loc,
        vn = vn,
        ve = ve,
        seq = seq_2,
        timestamp_ms = math.floor(t_s * 1000.0 + 0.5)
    }
end

local function ingest_latest_target()
    local latest = read_bus_target()
    if latest ~= nil and latest.loc ~= nil then
        kangaroo_loc_pending = latest
        return true
    end
    return false
end

-- =========================================================
-- Navigation helpers
-- =========================================================

function fly_to_dubins_point(point)
    if point == nil or point.loc == nil then
        return false
    end

    local home_alt_m = get_home_alt_m()
    if home_alt_m == nil then
        return false
    end

    local target_loc = point.loc:copy()
    target_loc:change_alt_frame(ALT_FRAME_ABSOLUTE)

    local target_alt_m = home_alt_m + get_kangaroo_alt_m() + PLANE_ABOVE_TARGET_M
    target_loc:set_alt_m(target_alt_m, ALT_FRAME_ABSOLUTE)

    return vehicle:set_target_location(target_loc)
end

local function get_point_accept_radius_m(point, point_after)
    local accept_radius_m = WP_ACCEPT_RADIUS_M

    if point == nil or point.loc == nil or point_after == nil or point_after.loc == nil then
        return accept_radius_m
    end

    local spacing_m = point.loc:get_distance(point_after.loc)
    if spacing_m == nil or spacing_m <= 0 then
        return accept_radius_m
    end

    local max_radius = spacing_m * 0.45
    return math.max(MIN_WP_ACCEPT_RADIUS_M, math.min(accept_radius_m, max_radius))
end

function dubins_point_reached(point, point_after)
    if point == nil then
        reached_streak = 0
        return false
    end

    if reached_index ~= dubins_point_index then
        reached_index = dubins_point_index
        reached_streak = 0
    end

    local pos = ahrs:get_position()
    if pos == nil or point.loc == nil then
        reached_streak = 0
        return false
    end

    local dist_ne = pos:get_distance_NE(point.loc)
    local dist_m = nil

    if dist_ne ~= nil then
        dist_m = math.sqrt(dist_ne:x() * dist_ne:x() + dist_ne:y() * dist_ne:y())
    end

    if dist_m == nil then
        reached_streak = 0
        return false
    end

    local accept_radius_m = get_point_accept_radius_m(point, point_after)

    if dist_m <= accept_radius_m then
        reached_streak = reached_streak + 1
        return reached_streak >= REACHED_STREAK_REQUIRED
    end

    reached_streak = 0
    return false
end

local function report_progress()
    if dubins_point_count == nil or dubins_point_index == nil or dubins_points_active == nil then
        return
    end

    local now_ms = millis():toint()
    if (now_ms - last_report_ms) < REPORT_INTERVAL_MS then
        return
    end

    local pos = ahrs:get_position()
    local point = current_point()
    local dist_2d = -1

    if pos ~= nil and point ~= nil and point.loc ~= nil then
        local dn = pos:get_distance_NE(point.loc)
        if dn ~= nil then
            dist_2d = math.sqrt(dn:x() * dn:x() + dn:y() * dn:y())
        end
    end

    gcs:send_text(4, string.format("Dubins point %d/%d dist=%.1fm", dubins_point_index, dubins_point_count, dist_2d))
    last_report_ms = now_ms
end

-- =========================================================
-- Path build / execution
-- =========================================================

local function update_build(target)
    local build_result, build_info = dubins_points.build_path(target)

    if build_result ~= nil and #build_result < MIN_DUBINS_POINTS then
        gcs:send_text(4, string.format("Dubins build rejected: only %d points", #build_result))
        build_result = nil
        build_info = "degenerate_path"
    end

    if build_result == nil or #build_result == 0 then
        dubins_points_active = nil
        dubins_point_index = nil
        dubins_point_count = nil
        controller_busy = false

        if build_info ~= nil then
            gcs:send_text(6, "Dubins build failed: " .. tostring(build_info))
        end
        return false
    end

    dubins_points_active = build_result
    dubins_point_index = 1
    dubins_point_count = #build_result
    controller_busy = true
    reset_reached_flags()

    gcs:send_text(4, string.format("New Dubins build: %d points", dubins_point_count))
    return true
end

local function try_build_from_pending()
    if kangaroo_loc_pending == nil or kangaroo_loc_pending.loc == nil then
        return false
    end

    local build_target = kangaroo_loc_pending
    local success = update_build(build_target)

    if success then
        kangaroo_loc_active = build_target
        kangaroo_loc_pending = nil
        return true
    end

    return false
end

local function execute_active_path_step()
    local point = current_point()
    local point_after = next_point()

    report_progress()

    if point == nil then
        return
    end

    if fly_to_dubins_point(point) then
        if dubins_point_reached(point, point_after) then
            gcs:send_text(4, string.format("Reached Dubins point %d/%d", dubins_point_index, dubins_point_count or 0))
            dubins_point_index = dubins_point_index + 1
        end
    else
        gcs:send_text(4, "Failed to set target for Dubins point")
    end
end

local function finish_active_path()
    gcs:send_text(4, "End of Dubins Curve!")

    local recycle_target = nil
    if kangaroo_loc_pending == nil and kangaroo_loc_active ~= nil then
        recycle_target = kangaroo_loc_active
    end

    reset_execution_state()

    if recycle_target ~= nil then
        kangaroo_loc_pending = recycle_target
        gcs:send_text(6, "Control: recycling active loc for rebuild")
    end
end

-- =========================================================
-- Main update loop
-- =========================================================

function update()
    local current_mode = vehicle:get_mode()

    if current_mode ~= MODE_AUTO and current_mode ~= MODE_GUIDED then
        reset_execution_state()
        set_state(STATES.IDLE)
        return update, UPDATE_PERIOD_MS
    end

    -- Always collect the freshest bus sample.
    ingest_latest_target()

    if state == STATES.IDLE then
        if kangaroo_loc_pending ~= nil and kangaroo_loc_pending.loc ~= nil then
            set_state(STATES.BUILD_PATH)
        end

    elseif state == STATES.BUILD_PATH then
        if try_build_from_pending() then
            set_state(STATES.EXECUTE_PATH)
        else
            set_state(STATES.HOLD)
        end

    elseif state == STATES.EXECUTE_PATH then
        if not controller_busy or dubins_points_active == nil then
            set_state(STATES.BUILD_PATH)
        else
            execute_active_path_step()

            if path_finished() then
                finish_active_path()

                if kangaroo_loc_pending ~= nil and kangaroo_loc_pending.loc ~= nil then
                    set_state(STATES.BUILD_PATH)
                else
                    set_state(STATES.IDLE)
                end
            end
        end

    elseif state == STATES.HOLD then
        -- Retry later using the latest pending target.
        if kangaroo_loc_pending ~= nil and kangaroo_loc_pending.loc ~= nil then
            set_state(STATES.BUILD_PATH)
        end
    else
        set_state(STATES.IDLE)
    end

    return update, UPDATE_PERIOD_MS
end

return update()
