-- NEW: centerline-anchored version.
-- The sinusoid is a fixed spatial wave defined along the line e -> kangaroo,
-- where e (anchor_x, anchor_y) is the plane position captured when weaving began.
-- The carrot rides ON that wave a look-ahead distance ahead of the plane's
-- along-track foot, so the achieved cross-track path ~= the designed sinusoid
-- (no 1/L amplitude collapse, no plane coupling).
function straight_weave(plane_x, plane_y, anchor_x, anchor_y, kangaroo_x, kangaroo_y, look, lambda, R_min, A_cap, d_start, d_full, eta, phase)

    -- Fixed centerline direction: anchor -> kangaroo
    local cx = kangaroo_x - anchor_x
    local cy = kangaroo_y - anchor_y
    local cline_len = math.sqrt(cx*cx + cy*cy)

    -- Degenerate centerline: fall back to commanding the kangaroo
    if cline_len < 1e-6 then
        return kangaroo_x, kangaroo_y
    end

    -- Unit tangent (t_hat) and left normal (n_hat) of the FIXED centerline
    local tx = cx / cline_len
    local ty = cy / cline_len
    local nx = -ty
    local ny = tx

    -- Along-track foot: projection of plane onto the centerline (sigma)
    local sigma = (plane_x - anchor_x) * tx + (plane_y - anchor_y) * ty

    -- Carrot along-track position: look-ahead ahead of the foot
    local s_hat = sigma + look

    -- Distance to kangaroo still drives the amplitude envelope
    local dx = kangaroo_x - plane_x
    local dy = kangaroo_y - plane_y
    local distance_to_kangaroo = math.sqrt(dx*dx + dy*dy)

    -- Distance-based, turn-radius-constrained amplitude
    local A = constrained_weave_amplitude(distance_to_kangaroo, lambda, R_min, A_cap, d_start, d_full, eta)

    -- Sine evaluated AT the carrot's own along-track position so the carrot
    -- sits on the spatial wave A*sin(2*pi*s_hat/lambda)
    local weave = A * math.sin((2 * math.pi * s_hat / lambda) + phase)

    -- Carrot on the fixed centerline, plus lateral offset along n_hat
    local base_x = anchor_x + s_hat * tx
    local base_y = anchor_y + s_hat * ty
    local ref_x = base_x + nx * weave
    local ref_y = base_y + ny * weave

    return ref_x, ref_y
end


return {
    straight_weave = straight_weave
}
